# ---------------------------------------------------------------- database --
# Supabase → Project Settings → Database → Connection string
# Pooled (app runtime, port 6543) and direct (migrations, port 5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------- server --
NODE_ENV="development"
PORT="4000"
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
# Public origin for published cards — QR codes encode this, so it must resolve.
# Local network testing: http://<your-lan-ip>:5173   Production: https://your-domain.com
PUBLIC_ORIGIN="https://tapcard.in"
EXTRA_ORIGINS=""

# --------------------------------------------------------------------- client --
# Baked into the frontend build. Must point at the deployed API and public origin.
VITE_API_URL="http://localhost:4000"
VITE_PUBLIC_ORIGIN="https://tapcard.in"

# Secrets: generate with `openssl rand -base64 48`. Never commit real values.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
ANALYTICS_SALT="replace-me"

# ------------------------------------------------------------------ storage --
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_STORAGE_BUCKET="tapcard-media"

# ----------------------------------------------------------------- payments --
# Phase 3. Test keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# -------------------------------------------------------------------- email --
# Phase 8.
EMAIL_FROM="TapCard <hello@tapcard.in>"
SMTP_URL=""
